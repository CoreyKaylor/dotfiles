Include ~/.config/colima/ssh_config

# GitHub through the 1Password SSH agent. The private key never leaves
# 1Password (Personal vault, "GitHub (ed25519)"); the .pub file tells ssh
# which agent key to offer. IdentityAgent wins over SSH_AUTH_SOCK, so this
# works inside herdr panes too. ~/.1password/agent.sock is where the Linux
# app puts the socket; on macOS install.sh links it to the Group Containers one.
Host github.com
  IdentityAgent ~/.1password/agent.sock
  IdentityFile ~/.ssh/github_ed25519.pub
  IdentitiesOnly yes
