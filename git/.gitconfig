[init]
	defaultBranch = main

[core]
	pager = delta
	editor = nvim
	excludesFile = ~/.config/git/ignore

[include]
	path = ~/.config/git/local

[diff]
	tool = diffbandit

[difftool]
	prompt = false

[difftool "diffbandit"]
	cmd = LOCAL=\"$LOCAL\" REMOTE=\"$REMOTE\" nvim -c 'lua require(\"user.pack\").load(\"diffbandit.nvim\") require(\"diffbandit\").files(vim.env.LOCAL, vim.env.REMOTE)'

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[merge]
	conflictStyle = zdiff3

[pull]
	ff = only

[push]
	autoSetupRemote = true

# Sign commits and tags with the GitHub SSH key held in 1Password. On macOS,
# install.sh points gpg.ssh.program at 1Password's op-ssh-sign in
# ~/.config/git/local; elsewhere ssh-keygen signs through a forwarded agent.
[user]
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIs0w01UMkCOGpl9eAO03U78bzE113Qz7XSwflQN9KhB

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[alias]
	br = branch
	co = checkout
	st = status --short --branch
	lg = log --graph --decorate --oneline --all

[user]
	email = corey@kaylors.net
	name = Corey Kaylor
